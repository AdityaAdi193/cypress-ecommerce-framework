{
  "name": "cypress-ecommerce-framework",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce end-to-end automation framework using Cypress, JavaScript, and TypeScript",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:chrome": "cypress run --browser chrome",
    "test:js": "cypress run --spec \"cypress/e2e/*.cy.js\"",
    "test:ts": "cypress run --spec \"cypress/e2e/*.cy.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "cypress": "^14.5.4",
    "typescript": "^5.8.3"
  }
}
